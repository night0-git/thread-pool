[
  {
    "label": "Debug native binary",
    "build": {
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "-j"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/bin/debug/thread-pool",
    "request": "launch",
    "adapter": "CodeLLDB"
  },

  {
    "label": "Debug test binary",
    "build": {
      "command": "cmake",
      "args": ["--build", "--preset", "debug", "-j"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/bin/debug/tests",
    "request": "launch",
    "adapter": "CodeLLDB"
  },

  {
    "label": "Debug test binary (with TSan)",
    "build": {
      "command": "cmake",
      "args": ["--build", "--preset", "tsan", "-j"],
      "cwd": "$ZED_WORKTREE_ROOT"
    },
    "program": "$ZED_WORKTREE_ROOT/bin/debug/tests",
    "request": "launch",
    "adapter": "CodeLLDB"
  }
]